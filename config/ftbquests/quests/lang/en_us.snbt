  "quest.49DEB3F88B437209.title": "Steam Foundation",
  "quest.49DEB3F88B437209.quest_desc": [
    "Create sheets lead to the first hammer; primitive steel and the Ars book lead to both sources of AE presses."
  ],
  "quest.432E2A1085843147.title": "Basic Electronic Component · ULV",
  "quest.432E2A1085843147.quest_desc": [
    "AE processors and steel replace the old vacuum tube. This is the actual ULV component used by early GT recipes."
  ],
