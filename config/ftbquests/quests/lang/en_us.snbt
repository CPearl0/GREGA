{
  "file.0000000000000001.title": "GREGA",
  "chapter.25569D0A4F2ACDAF.title": "First Gears, First Circuits",
  "quest.2374AD6C2B265EA7.title": "Power a Mechanical Press",
  "quest.2374AD6C2B265EA7.quest_desc": [
    "Start with andesite alloy, a shaft and a water wheel. Split iron ingots into nuggets for the alloy. Craft the first press from iron ingots, then use it to press your hammer plates."
  ],
  "quest.4057BD31B7AEEFA4.title": "Press Before You Hammer",
  "quest.4057BD31B7AEEFA4.quest_desc": [
    "Press iron ingots into six iron sheets. These are the head of your first GT hammer."
  ],
  "quest.4CCCA71DE7C1DF3B.title": "The First Forging Hammer",
  "quest.4CCCA71DE7C1DF3B.quest_desc": [
    "Combine six Create iron sheets with a wooden rod. Use GT tools and plates to build bronze steam machines; keep vents clear."
  ],
  "quest.6A989482F36FB02E.title": "Bronze and Steam",
  "quest.6A989482F36FB02E.quest_desc": [
    "Mix 3 Copper Dust and 1 Tin Dust into 4 Bronze Dust using a Create Mechanical Mixer and Basin, without heat. Crafting-table and GT mixer powder recipes are removed. Build a boiler and steam machines; the Steam Alloy Smelter supplies Red Alloy before electricity."
  ],
  "quest.19E0159F45B7AAEA.title": "A Furnace Made of Earth",
  "quest.19E0159F45B7AAEA.quest_desc": [
    "Build the GT Primitive Blast Furnace with primitive bricks. Iron or wrought iron and coal/charcoal provide your first steel; this stage needs no electric circuit."
  ],
  "quest.0AF73F7721E7F090.title": "The Steel Threshold",
  "quest.0AF73F7721E7F090.quest_desc": [
    "Prepare two Steel Plates for binding the spell book with Manasteel Dust and a Mana-infused Book. Save steel for GT tools and Basic Electronic Components too."
  ],
  "quest.4E20CCAD4ABA1ED3.title": "Bind a Spell Book with Steel and Mana",
  "quest.4E20CCAD4ABA1ED3.quest_desc": [
    "Craft in this exact 3x3 arrangement: File / Manasteel Dust / Forge Hammer; Steel Plate / Mana-infused Book / Steel Plate; Lapis Dust / Gold Dust / Redstone Dust. GT tools take normal crafting damage and are returned.",
    "Infuse an ordinary Book in a Mana Pool with 3000 mana to make the Mana-infused Book. Use Botania's own Manasteel Ingots and grind them with a GT Mortar or Macerator. Higher spell books still upgrade from this one."
  ],
  "quest.47D833C0F30AC57D.title": "Travel Written in a Book",
  "quest.47D833C0F30AC57D.quest_desc": [
    "At a Scribe's Table, select the four GREGA tier-one effect glyphs using your spell book. Each costs 27 XP points plus its recipe ingredients. Take the glyph and use it to learn the effect. Nether Gate needs obsidian, steel and a Source Gem; no Nether visit is required.",
    "Open the Ars spell editor (default C), assemble and save Touch → Nether Gate, then cast at the inner face of a complete obsidian frame in the Overworld or Nether. Ordinary fire, flint and steel, dispensers, GT lighters and lava cannot open it.",
    "Self → Set Home saves a safe position near your feet in the Overworld. Self → Homeward returns from any dimension. Your home survives death.",
    "Self → Wander performs Overworld RTP, checking up to eight safe surface locations 512–2048 blocks from spawn. Homeward and Wander share a 60-second cooldown; failed safety searches delay retries by 5 seconds. Dismount and wake up first. Effect mana costs are 80/20/80/100, plus the casting method."
  ],
  "quest.47D833C0F30AC57D.quest_subtitle": "Assemble travel spells in your book",
  "task.6566FE169F275B70.title": "Obtain the Nether Gate glyph",
  "quest.2B63D4A0FB2EE0FF.title": "Alien Masters",
  "quest.2B63D4A0FB2EE0FF.quest_desc": [
    "Break a meteorite's mysterious cube to recover logic, calculation, engineering and germanium presses. Germanium is alien technology: keep it as a relic; no human recipe accepts it."
  ],
  "quest.09831E6BAD1F88D9.title": "The Piglin Revision",
  "quest.09831E6BAD1F88D9.quest_desc": [
    "Barter gold ingots with adult piglins. Their extra rewards include logic, calculation and silicon presses, with equal weights. They never supply engineering. Meteorites never supply silicon."
  ],
  "quest.763FB77B42C26AA4.title": "Four Usable Presses",
  "quest.763FB77B42C26AA4.quest_desc": [
    "You need logic, calculation, engineering and silicon. The four detection tasks do not consume your presses. Copies still require an existing master press."
  ],
  "quest.1111482F6BF29F70.title": "Steam Inscribing",
  "quest.1111482F6BF29F70.quest_desc": [
    "Craft the Steam Inscriber from a Bronze Machine Casing, six Small Bronze Fluid Pipes and two Pistons, without circuits. Supply steam and keep its vent clear. Presses are reusable; assemble printed circuits, printed silicon and Red Alloy Plates into AE processors.",
    "Electric Inscribers are available at every standard voltage tier, using a matching Hull, two Electric Pistons, two Circuits and four Cables, with standard overclocking. AE2's original Inscriber crafting and processing recipes are removed."
  ],
  "quest.09E8E27A5CBB94B5.title": "The New Electronic Foundation",
  "quest.09E8E27A5CBB94B5.quest_desc": [
    "Craft in this exact 3×3 arrangement: hammer / file / wire cutter; logic / calculation / engineering processors; red alloy cable / steel plate / red alloy cable. GT tools return with their normal crafting damage. This part replaces vacuum tubes, including the ULV circuit tag used by the circuit assembler."
  ],
  "chapter.3A404246AC67A6B3.title": "GregTech Milestones",
  "quest.7B899364DA8634EF.title": "The GREGA Milestone Map",
  "quest.7B899364DA8634EF.quest_desc": [
    "Columns show circuit ratings from ULV through UHV. Check the recipe viewer for manufacturing voltage. Every node detects a real item without consuming it.",
    "Electronic and integrated names and ratings stay unchanged. The Microchip Processor is removed. Micro circuits rate LV–EV; nano circuits rate MV–IV and use short recipes with light materials. From Micro onward, each family uses its own prefix followed by Compute Unit → Processor Core → Multicore Processor → High-Performance Computer.",
    "The independent HV–LuV 3D Nano family is 3D Nano Compute Unit → 3D Nano Processor Core → 3D Nano Multicore Processor → 3D Nano High-Performance Computer. Produce via substrates, bonded nano dies and multilayer interconnects first, using GregTech materials and machines.",
    "Quantum, crystal and wetware retain their original GregTech recipes. These families do not require GREGA 3D Nano circuits. Materials and coils have their own item milestones."
  ],
  "quest.31D93CB341C27342.title": "ULV Machine Hull",
  "quest.31D93CB341C27342.quest_desc": [
    "Obtain this tier of machine hull. Circuits in the column are arranged by their rating; check each recipe for its manufacturing voltage."
  ],
