  ],
  "quest.6D4A1B8E2C903F10.title": "Pure Daisy, Livingwood and Livingrock",
  "quest.6D4A1B8E2C903F10.quest_desc": [
    "Start with Mystical Flowers and a Petal Apothecary. Make a Pure Daisy using white petals and seeds. Place logs and stone around it to turn them into Livingwood and Livingrock; consult the Lexica Botania for the full steps."
  ],
  "quest.6D4A1B8E2C903F20.title": "The First Mana",
  "quest.6D4A1B8E2C903F20.quest_desc": [
    "Build a Mana Spreader from Livingwood and a Mana Pool from Livingrock. Bind an Endoflame to the spreader with a Wand of the Forest and point the spreader at the pool. Drop fuel near the Endoflame to start filling the pool."
  ],
  "quest.6D4A1B8E2C903F30.title": "Mana in Steel and Paper",
  "quest.6D4A1B8E2C903F30.quest_desc": [
    "Drop an Iron Ingot into a sufficiently filled Mana Pool to obtain Botania's own Manasteel Ingot. Manasteel is a GT material: grind an ingot into dust with a GT Mortar, or later use a Macerator.",
    "Drop an ordinary Book into the pool and spend 3000 mana to obtain a Mana-infused Book. Together with Manasteel Dust and Steel Plates, it opens the Ars Nouveau mainline."
  ]
}
