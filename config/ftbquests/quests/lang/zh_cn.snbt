  "quest.49DEB3F88B437209.title": "蒸汽基础",
  "quest.49DEB3F88B437209.quest_desc": [
    "Create 铁板材通往第一把锻造锤；土高炉钢与法术书将带你找到 AE 模板的两种来源。"
  ],
  "quest.432E2A1085843147.title": "基础电子电路部件 · ULV",
  "quest.432E2A1085843147.quest_desc": [
    "AE 处理器与钢取代旧真空管，成为前期 GT 配方实际使用的 ULV 部件。"
  ],
  "quest.22AF2D684A44EE79.title": "基础电子电路 · LV",
  "quest.22AF2D684A44EE79.quest_desc": [
