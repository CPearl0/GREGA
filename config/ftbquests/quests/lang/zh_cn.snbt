{
  "file.0000000000000001.title": "各类格雷科技 · GREGA",
  "chapter.25569D0A4F2ACDAF.title": "初转齿轮，初成电路",
  "quest.2374AD6C2B265EA7.title": "驱动机械压力机",
  "quest.2374AD6C2B265EA7.quest_desc": [
    "从安山合金、传动杆和水车开始。铁锭可拆成铁粒来制作安山合金；第一台机械压力机直接使用铁锭制作，再用它压出锻造锤所需的铁板材。"
  ],
  "quest.4057BD31B7AEEFA4.title": "先压板，再锻造",
  "quest.4057BD31B7AEEFA4.quest_desc": [
    "用机械压力机把铁锭压成铁板材。准备六张，为第一把 GT 锻造锤制作锤头。"
  ],
  "quest.4CCCA71DE7C1DF3B.title": "第一把锻造锤",
  "quest.4CCCA71DE7C1DF3B.quest_desc": [
    "将六张 Create 铁板材与木棒组合成铁锻造锤。随后按 GT 工具与板材路线制作青铜蒸汽机器，并保持排气口畅通。"
  ],
  "quest.6A989482F36FB02E.title": "青铜与蒸汽",
  "quest.6A989482F36FB02E.quest_desc": [
    "将铜粉和锡粉混合制成青铜，搭建小型锅炉和蒸汽机器。蒸汽合金炉可在电力之前供应红色合金。"
  ],
  "quest.19E0159F45B7AAEA.title": "以土石筑炉",
  "quest.19E0159F45B7AAEA.quest_desc": [
    "用土高炉砖搭建 GT 土高炉。以铁或锻铁配合煤、木炭炼出第一批钢，这一步不需要电路。"
  ],
  "quest.0AF73F7721E7F090.title": "钢的门槛",
  "quest.0AF73F7721E7F090.quest_desc": [
    "钢板用于装订第一本新生魔艺法术书。也要为 GT 工具和基础电子电路部件留出钢。"
  ],
  "quest.4E20CCAD4ABA1ED3.title": "以钢装订法术书",
  "quest.4E20CCAD4ABA1ED3.quest_desc": [
    "用书、三张钢板与青金石制作入门法术书。更高级法术书仍从这本书升级。"
  ],
  "quest.47D833C0F30AC57D.title": "写在书页中的旅途",
  "quest.47D833C0F30AC57D.quest_desc": [
    "主手持任意等级法术书，潜行右键黑曜石门框内侧来开启下界门。普通火焰、打火石、发射器和熔岩都不能开启门。",
    "在主世界持书潜行右键床绑定家；持书潜行右键工作台可从任意维度回家。家坐标在死亡后保留。",
    "在主世界持书潜行右键苔藓块进行 RTP：在世界出生点周围 512–2048 格寻找至多八处地表落点，仅接受安全位置。回家与 RTP 共用 60 秒冷却，安全搜索失败后等待 5 秒再试。"
  ],
  "quest.47D833C0F30AC57D.quest_subtitle": "已实装：法术书交互",
  "task.6566FE169F275B70.title": "已阅读法术书交互说明",
  "quest.2B63D4A0FB2EE0FF.title": "陨石里的外星模板",
  "quest.2B63D4A0FB2EE0FF.quest_desc": [
    "打破陨石中的神秘方块可获得逻辑、运算、工程、锗四种模板。锗模板属于外星工艺，可收藏，但不能用于人类的压印或合成。"
  ],
  "quest.09831E6BAD1F88D9.title": "猪灵的改良版",
  "quest.09831E6BAD1F88D9.quest_desc": [
    "用金锭与成年猪灵以物易物。新增奖励为等权重的逻辑、运算、硅模板，不含工程模板；陨石则不出硅模板。"
  ],
  "quest.763FB77B42C26AA4.title": "凑齐四块可用模板",
  "quest.763FB77B42C26AA4.quest_desc": [
    "最终需要逻辑、运算、工程、硅四块模板。检测不会消耗模板；复制模板也必须先有一块母版。"
  ],
  "quest.1111482F6BF29F70.title": "以蒸汽压印",
  "quest.1111482F6BF29F70.quest_desc": [
    "用青铜板、铜板、活塞、青铜机器外壳与扳手制作 GREGA 蒸汽压印机，不需要电路。输入蒸汽并留出排气空间，模板不消耗。用印刷电路、印刷硅与红色合金板组装各类处理器。本包移除了 AE 原版压印器的制作与压印配方。"
  ],
  "quest.09E8E27A5CBB94B5.title": "新的电子基础",
  "quest.09E8E27A5CBB94B5.quest_desc": [
    "按指定 3×3 排列合成：第一行锤、锉刀、剪线钳；第二行逻辑、运算、工程处理器；第三行红色合金线缆、钢板、红色合金线缆。GT 工具按正常合成规则损耗并返还。此部件替代真空管，也进入电路装配机使用的 ULV 电路标签。"
  ],
  "chapter.3A404246AC67A6B3.title": "格雷里程碑",
  "quest.7B899364DA8634EF.title": "阅读 GREGA 路线图",
  "quest.7B899364DA8634EF.quest_desc": [
    "列表示电路的额定等级（ULV 至 UHV），不等于制造电路所需电压；行表示电路系列。材料、线圈各有独立的行。",
    "电子、集成、微型电路沿用 GT 进度。纳米计划前移为 MV–IV 的轻量过渡，其后增加 HV–LuV 叠层纳米系列，位于晶体之前。",
    "量子、晶体、湿件系列保留；量子及其后系列均计划使用叠层纳米产物。本次仅列出设计：纳米前移配方、叠层配方及后续替换均尚未实装。",
    "菱形可选勾选项表示设计里程碑，并非生存解锁；勾选仅记录已阅读。普通物品任务检测已有电路与材料，不会消耗物品。"
  ],
  "task.778C28F4124FC998.title": "已阅读此规划里程碑",
