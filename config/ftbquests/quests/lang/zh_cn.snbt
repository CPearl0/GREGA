	quest.06C2363AE1E4CD32.title: "湿件处理器核心 · ZPM"
	quest.07EB8F4D03A46922.quest_desc: ["具有划时代意义的材料！"]
	quest.0A00D22823E90B18.title: "各类格雷工具"
	quest.0C399E408066B228.quest_desc: [
		"右键原木以将其雕刻成图腾基座。我们之后的演奏都要在其周围。"
		"如果你有任何疑问，可以打开图腾百科全书查看。"
	]
	quest.0F2A3E2C86D780C9.quest_desc: ["路上见到可以顺手采一些，将来会用到"]
	quest.0F2A3E2C86D780C9.title: "五颜六色的花"
