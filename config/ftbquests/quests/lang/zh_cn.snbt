  ],
  "quest.6D4A1B8E2C903F10.title": "白雏菊与活木活石",
  "quest.6D4A1B8E2C903F10.quest_desc": [
    "从神秘花与花药台开始，用白色花瓣和种子制作白雏菊。把原木与石头放在白雏菊周围，分别转化为活木和活石；植物魔法辞典可随时查阅完整步骤。"
  ],
  "quest.6D4A1B8E2C903F20.title": "最初的魔力",
  "quest.6D4A1B8E2C903F20.quest_desc": [
    "用活木制作魔力发射器，用活石制作魔力池。用森林法杖把炽玫瑰绑定到发射器，再让发射器指向池。炽玫瑰消耗投掷在附近的燃料，把魔力积存在池里。"
  ],
  "quest.6D4A1B8E2C903F30.title": "把魔力写入钢与书",
  "quest.6D4A1B8E2C903F30.quest_desc": [
    "把铁锭投入有足够魔力的池，得到植物魔法原生的魔力钢锭。魔力钢已注册为 GT 材料：用研钵磨成魔力钢粉，后续也可用打粉机加工。",
    "再将普通书投入魔力池，消耗3000魔力得到魔力书。带上魔力钢粉、魔力书和钢板，主线便可进入新生魔艺。"
  ]
}
