# Dependencies are described by Packwiz, never committed as binaries.
*.jar
*.class
*.dll
*.dll.x
*.so
*.dylib
*.exe

# Launcher, Minecraft installation, and caches.
/.minecraft/
/.hmcl/
/.mixin.out/
/assets/
/libraries/
/versions/
/runtime/
/natives*/
/downloads/
/GREGA.json
/log4j2.xml
.cache/

# Game state and per-machine data.
/saves/
/backups/
/logs/
/crash-reports/
/screenshots/
/debug/
/dumps/
/replay_recordings/
/local/
/moddata/
/xaero/
/XaeroWaypoints_BACKUP*/
/journeymap/
/gtceu/prospection_cache/
/emi.json
/options*.txt
/servers.dat*
/usercache.json
/usernamecache.json
/session.lock
/patchouli_data.json
# Ignore launcher/mod autogenerated or rewritten configs by default.
# Only track pack-authored customizations via the whitelist below.
/config/*
!/config/gtceu.yaml
!/config/twilightforest-common.toml
!/config/almostunified/
/config/almostunified/*
!/config/almostunified/unification/
/config/almostunified/unification/*
!/config/almostunified/unification/materials.json
!/config/almostunified/unification/certus_quartz.json
!/config/ftbquests/
!/config/ftbquests/**

/kubejs/config/web_server.json
/kubejs/cache/
/kubejs/.cache/
/kubejs/exported/
/kubejs/probe/

# Build/export output, editor files, and credentials.
/.gradle/
/build/
/dist/
/out/
/run/
/repo/
/.idea/
/.vscode/
*.log
*.tmp
*.bak
*.iml
.DS_Store
Thumbs.db
.env
.env.*
!.env.example
*.pem
*.key
